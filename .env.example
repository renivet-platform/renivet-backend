NODE_ENV=development
PORT=4000
HOST=127.0.0.1
DATABASE_URL=postgres://renivet:renivet_local_only@localhost:5432/renivet
REDIS_URL=redis://localhost:6379
# Local development only; set a private random value of at least 32 characters.
AUTH_RATE_LIMIT_HMAC_KEY=local-only-set-a-random-32-byte-value
# Dedicated key for session-bound CSRF proofs (minimum 32 characters).
AUTH_CSRF_HMAC_KEY=local-only-set-a-csrf-key-with-at-least-32-bytes
# Optional for local development; required in staging/production. Generate a private 32-byte key and base64-encode it.
# AUTH_MFA_ENCRYPTION_KEY=
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:3000
AUTH_SESSION_IDLE_TTL_SECONDS=1800
AUTH_SESSION_ABSOLUTE_TTL_SECONDS=604800
# Separate private key for purpose-bound OTP challenge proofs (minimum 32 characters).
AUTH_CHALLENGE_HMAC_KEY=local-only-set-a-random-32-byte-value
AUTH_CHALLENGE_TTL_SECONDS=300
AUTH_CHALLENGE_MAX_ATTEMPTS=5
AUTH_CHALLENGE_RESEND_COOLDOWN_SECONDS=60
AUTH_CHALLENGE_RESEND_WINDOW_SECONDS=900
AUTH_CHALLENGE_RESEND_MAX=3
AUTH_CHALLENGE_IP_LIMIT=30
AUTH_CHALLENGE_IDENTITY_LIMIT=5
AUTH_CHALLENGE_VERIFY_IP_LIMIT=60
# Never store actual secrets in git. Replace all local credentials for staging/production.
TYPESENSE_URL=http://127.0.0.1:8108
TYPESENSE_API_KEY=local-typesense-do-not-deploy
PYTHON_SERVICE_URL=http://127.0.0.1:8000

# Fast2SMS DLT SMS delivery. Leave empty to keep phone OTP delivery safely unavailable.
FAST2SMS_API_KEY=
FAST2SMS_MESSAGE_ID=
FAST2SMS_SENDER_ID=
FAST2SMS_DLT_ENTITY_ID=

# Email OTP delivery over SMTP (leave unset to keep email delivery safely unavailable).
# Set SMTP_HOST, SMTP_FROM, SMTP_USERNAME, and SMTP_PASSWORD together.
# SMTP_PORT defaults to 587; SMTP_SECURE defaults to true only for port 465.
# Example values are intentionally omitted. Keep real SMTP credentials in local .env/secrets only.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=
