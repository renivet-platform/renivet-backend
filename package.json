{
  "name": "renivet-backend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12 <25"
  },
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "api:generate": "npm run build && node scripts/export-openapi.cjs && node node_modules/openapi-typescript/bin/cli.js openapi/renivet.openapi.json -o src/generated/api-schema.d.ts",
    "api:check": "npm run build && node scripts/check-generated-api.cjs && node scripts/check-postman-contract.cjs && node scripts/w2-contract-traceability.cjs",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\" drizzle.config.ts",
    "test": "node --test tests/*.test.cjs",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "deps:check": "node --env-file=.env scripts/check-dependencies.cjs",
    "deps:check:syntax": "node --check scripts/check-dependencies.cjs"
  },
  "dependencies": {
    "@fastify/static": "^10.1.7",
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-fastify": "^12.2.0",
    "@nestjs/swagger": "^12.0.4",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^6.0.0",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.10",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "js-yaml": "^5.5.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.0"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "glob": "^14.0.2"
  }
}
